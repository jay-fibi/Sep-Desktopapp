<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shared geometry for every keypad button. backgroundTint is cleared so
         the theme's buttonStyle can never tint our per-theme drawables. -->
    <style name="Widget.Calculator.Button" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/button_margin</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="Widget.Calculator.Button.Digit">
        <item name="android:background">@drawable/bg_button_digit</item>
        <item name="android:textColor">?attr/calcButtonDigitText</item>
    </style>

    <style name="Widget.Calculator.Button.Action">
        <item name="android:background">@drawable/bg_button_action</item>
        <item name="android:textColor">?attr/calcButtonActionText</item>
    </style>

    <style name="Widget.Calculator.Button.Operator">
        <item name="android:background">@drawable/bg_button_operator</item>
        <item name="android:textColor">?attr/calcButtonOperatorText</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Calculator.Button.Equals">
        <item name="android:background">@drawable/bg_button_equals</item>
        <item name="android:textColor">?attr/calcButtonEqualsText</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
