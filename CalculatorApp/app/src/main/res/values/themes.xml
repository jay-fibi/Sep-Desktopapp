<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shared configuration. The ?attr/... references are resolved when the
         theme is applied, so each concrete theme below only sets colors. -->
    <style name="Theme.Calculator.Base.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">?attr/calcBackground</item>
        <item name="android:statusBarColor">?attr/calcBackground</item>
        <item name="android:navigationBarColor">?attr/calcBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Material colors, so dialogs follow the active theme -->
        <item name="colorPrimary">?attr/calcButtonEquals</item>
        <item name="colorSurface">?attr/calcDisplayBackground</item>
        <item name="colorOnSurface">?attr/calcDisplayTextPrimary</item>
    </style>

    <style name="Theme.Calculator.Base.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">?attr/calcBackground</item>
        <item name="android:statusBarColor">?attr/calcBackground</item>
        <item name="android:navigationBarColor">?attr/calcBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">?attr/calcButtonEquals</item>
        <item name="colorSurface">?attr/calcDisplayBackground</item>
        <item name="colorOnSurface">?attr/calcDisplayTextPrimary</item>
    </style>

    <style name="Theme.Calculator.Light" parent="Theme.Calculator.Base.Light">
        <item name="calcBackground">@color/light_background</item>
        <item name="calcDisplayBackground">@color/light_display</item>
        <item name="calcDisplayTextPrimary">@color/light_text_primary</item>
        <item name="calcDisplayTextSecondary">@color/light_text_secondary</item>
        <item name="calcButtonDigit">@color/light_digit</item>
        <item name="calcButtonDigitText">@color/light_digit_text</item>
        <item name="calcButtonAction">@color/light_action</item>
        <item name="calcButtonActionText">@color/light_action_text</item>
        <item name="calcButtonOperator">@color/light_operator</item>
        <item name="calcButtonOperatorText">@color/light_operator_text</item>
        <item name="calcButtonEquals">@color/light_equals</item>
        <item name="calcButtonEqualsText">@color/light_equals_text</item>
        <item name="calcRipple">@color/light_ripple</item>
        <item name="calcIconTint">@color/light_icon</item>
    </style>

