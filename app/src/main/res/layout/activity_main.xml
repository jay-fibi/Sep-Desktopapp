<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jack_bg"
    android:orientation="vertical">

    <!-- Top Branding & App Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/jack_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Jacks calc Logo"
            android:src="@drawable/ic_jacks_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jacks calc"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Write notes with figures &amp; calculate"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Top Action Buttons -->
        <ImageButton
            android:id="@+id/btnNew"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="New Note"
            android:src="@android:drawable/ic_menu_add"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnLibrary"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notes Library"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share"
            android:src="@android:drawable/ic_menu_share"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Note Title Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <EditText
            android:id="@+id/etNoteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/enter_title"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/save_note"
            android:textColor="@color/jack_accent"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSample"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Demo"
            android:textColor="@color/jack_accent_gold"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/jack_card_border" />

    <!-- Split Editor & Live Calculation Results Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: Text Editor for Notes with figures -->
        <ScrollView
            android:id="@+id/scrollViewEditor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="65"
            android:background="#FFFFFF"
            android:fillViewport="true">

            <EditText
                android:id="@+id/etEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="@string/editor_placeholder"
                android:inputType="textMultiLine|textNoSuggestions"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:scrollHorizontally="false"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />
        </ScrollView>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/jack_card_border" />

        <!-- Right: Live Line Calculation Column -->
        <ScrollView
            android:id="@+id/scrollViewResults"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="35"
            android:background="@color/calc_result_bg"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvResultsColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="top|end"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:textColor="@color/calc_result_green"
                android:textSize="15sp"
                android:textStyle="bold" />
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Grand Total Summary Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/jack_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvItemsCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 items"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL = "
            android:textColor="#F59E0B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGrandTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Numeric & Math Symbol Bar for fast entry -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E2E8F0"
        android:padding="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quickToolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickPlus"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickMinus"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="-"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickMult"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="*"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickDiv"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="/"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickPercent"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="%"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickEquals"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="="
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickColon"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text=":"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickTotal"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="total"
                android:textAllCaps="false"
                android:textColor="@color/jack_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickAvg"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="average"
                android:textAllCaps="false"
                android:textColor="@color/jack_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickSqrt"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="sqrt()"
                android:textAllCaps="false"
                android:textColor="@color/jack_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
